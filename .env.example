# Copy this file to .env and fill in your key.
# The key is read only by the Node/Vite server, never by the browser.

ELEVENLABS_API_KEY=

# The stage always uses the fixed seven-voice bank coded in
# src/data/elevenVoices.js. Defaults are Mike (side A) and Jon (side B);
# voices are chosen in the UI. No env voice overrides are read.
#   Mike:        cBTYF7NiJbR8Bvmdeuse
#   Jon:         JYUzXNeyCPmymMkfcicu
#   Adam:        QAmlwgbPtjxpk7u98Qs9
#   Nick:        7jynqzOvnVP89nA7TB0m
#   Mark:        1SM7GgM6IMuvQlz2BwM3
#   David:       ppLqTilh7rH7fbUVlXsf
#   Extra voice: B9U4Lk9uR0DBeFxDocVd

# Optional: Natural, quality-first model (default).
# Use eleven_v4 for maximum expression or eleven_turbo_v2_5 for fastest replies.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: if set, custom debates are researched with OpenAI web search and
# generated with sourced, topic-specific arguments. Falls back to curated copy.
OPENAI_API_KEY=
# Optional: OpenAI Responses model used for research-backed generation.
OPENAI_MODEL_ID=gpt-4.1-mini
